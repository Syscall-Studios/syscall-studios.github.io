{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard.
	"name": "syscall-studios-github-io",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"routes": [
		{
			"pattern": "syscallstudios.com",
			"custom_domain": true
		}
	],
	// Pages are served straight from dist/ without running any code, so page views
	// never count toward the Worker's daily request limit. Only /api/* runs the Worker.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "syscall-newsletter",
			"database_id": "372dbaff-e0cc-436d-9033-56b5affdd310"
		}
	],
	// Each IP address can submit the sign-up form 5 times a minute.
	"ratelimits": [
		{
			"name": "SIGNUP_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		// Sign-ups are only accepted when Turnstile says the form was on one of these hostnames.
		// Never add localhost or 127.0.0.1 here.
		"TURNSTILE_HOSTNAMES": "syscallstudios.com,www.syscallstudios.com"
	},
	// Branch previews get <branch>-syscall-studios-github-io.syscallstudios-cloudflare.workers.dev URLs,
	// which Cloudflare serves with X-Robots-Tag: noindex.
	"preview_urls": true,
	// Previews don't inherit anything above. They write to a separate test database and only accept
	// Cloudflare's always-pass Turnstile test key, which preview builds put in the form.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "syscall-newsletter-preview",
				"database_id": "f10bc7dd-d971-4624-9b37-180782d3c768"
			}
		],
		"ratelimits": [
			{
				"name": "SIGNUP_LIMITER",
				"namespace_id": "1002",
				"simple": {
					"limit": 5,
					"period": 60
				}
			}
		],
		"vars": {
			// Not a real secret: Cloudflare's published always-pass test key.
			"TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
			"TURNSTILE_HOSTNAMES": "example.com",
			"TURNSTILE_ALLOW_TEST_KEYS": "true"
		}
	}
}