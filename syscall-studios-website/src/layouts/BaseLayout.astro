---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    noIndex?: boolean;
}

const {
    title = site.studioName,
    description = site.tagline,
    image = "/brand/logo-full-horizontal-dark.svg",
    noIndex = false
} = Astro.props;

const pageTitle =
    title === site.studioName
        ? title
        : `${title} | ${site.studioName}`;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site ?? Astro.url
);

const imageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta
            name="description"
            content={description}
        />

        {
            noIndex && (
                <meta
                    name="robots"
                    content="noindex, nofollow"
                />
            )
        }


        <!-- Canonical -->

        <link
            rel="canonical"
            href={canonicalURL}
        />

        <link
            rel="alternate"
            type="application/rss+xml"
            title="Syscall Studios Dev Log"
            href="/rss.xml"
        />


        <!-- Favicons -->

        <link
            rel="icon"
            href="/favicon.svg"
            type="image/svg+xml"
        />

        <link
            rel="alternate icon"
            href="/favicon.ico"
            type="image/x-icon"
        />


        <!-- Page Title -->

        <title>{pageTitle}</title>


        <!-- OpenGraph -->

        <meta
            property="og:type"
            content="website"
        />

        <meta
            property="og:title"
            content={pageTitle}
        />

        <meta
            property="og:description"
            content={description}
        />

        <meta
            property="og:url"
            content={canonicalURL}
        />

        <meta
            property="og:site_name"
            content="Syscall Studios"
        />

        <meta
            property="og:image"
            content={imageURL}
        />


        <!-- Twitter / Social Cards -->

        <meta
            name="twitter:card"
            content="summary_large_image"
        />

        <meta
            name="twitter:title"
            content={pageTitle}
        />

        <meta
            name="twitter:description"
            content={description}
        />

        <meta
            name="twitter:image"
            content={imageURL}
        />


        <!-- Theme -->

        <meta
            name="theme-color"
            content="#434b57"
        />
    </head>

    <body>
        <a class="skip-link" href="#main-content">
            Skip to content
        </a>

        <Header />

        <main id="main-content">
            <slot />
        </main>

        <Footer />

    </body>
</html>