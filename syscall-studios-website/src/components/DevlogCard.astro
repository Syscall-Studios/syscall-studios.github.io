---
import { formatDate } from "../lib/format-date";

interface Props {
    id: string;
    title: string;
    description: string;
    pubDate: Date;
    tags?: string[];
}

const {
    id,
    title,
    description,
    pubDate,
    tags = []
} = Astro.props;

const formattedDate = formatDate(pubDate);
---

<article class="devlog-card">
    <a href={`/devlog/${id}/`} class="card-link">

        <div class="card-meta">
            <time class="card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
            {tags.map((tag) => <span class="card-tag">{tag}</span>)}
        </div>

        <div class="card-content">
            <div>
                <h3>{title}</h3>
                <p>{description}</p>
            </div>

            <span class="arrow" aria-hidden="true">→</span>
        </div>

    </a>
</article>

<style>
    .devlog-card {
        border-top: 1px solid var(--line-strong);
    }

    .devlog-card:last-child {
        border-bottom: 1px solid var(--line-strong);
    }

    .card-link {
        position: relative;

        display: block;

        padding: clamp(1.75rem, 4vw, 2.75rem) 0;

        transition: padding var(--transition-normal);
    }

    .card-link::before {
        position: absolute;
        inset: 0;

        background: linear-gradient(
            90deg,
            rgb(121 83 245 / 12%),
            transparent 70%
        );

        content: "";
        opacity: 0;
        transition: opacity var(--transition-normal);
    }

    .card-link:hover,
    .card-link:focus-visible {
        padding-inline: 1.25rem;
    }

    .card-link:hover::before,
    .card-link:focus-visible::before {
        opacity: 1;
    }

    .card-meta {
        position: relative;

        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;

        margin-bottom: 1rem;

        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .card-date {
        color: var(--color-purple-bright);
    }

    .card-tag + .card-tag::before,
    .card-date + .card-tag::before {
        margin-right: 1rem;

        color: var(--color-dim);

        content: "·";
    }

    .card-content {
        position: relative;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 3rem;
    }

    h3 {
        margin-bottom: 0.75rem;

        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    p {
        max-width: 42rem;

        margin-bottom: 0;

        color: var(--color-muted);
    }

    .arrow {
        flex-shrink: 0;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 2rem;

        transition: transform var(--transition-fast);
    }

    .card-link:hover .arrow,
    .card-link:focus-visible .arrow {
        transform: translateX(6px);
    }

    @media (max-width: 650px) {
        .card-content {
            gap: 1.5rem;
        }

        .arrow {
            font-size: 1.5rem;
        }
    }
</style>
