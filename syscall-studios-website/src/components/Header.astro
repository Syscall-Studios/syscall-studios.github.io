---
import navItems from "../data/nav.json";

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-scrolled="false">
    <div class="container header-inner">
        <a
            class="brand"
            href="/"
            aria-label="Syscall Studios Home"
        >
            <img
                src="/brand/logo-full-horizontal-light.svg"
                alt=""
                class="brand-logo"
                width="1037"
                height="90"
            />
        </a>

        <button
            class="menu-toggle"
            type="button"
            aria-controls="main-navigation"
            aria-expanded="false"
            aria-label="Menu"
        >
            <span class="menu-label">Menu</span>
        </button>

        <nav
            class="nav"
            id="main-navigation"
            aria-label="Main navigation"
            data-open="false"
        >
            {
                navItems.map((item) => {
                    const isCurrent = `${currentPath}/`.startsWith(item.href);

                    return (
                        <a
                            href={item.href}
                            class="nav-link"
                            aria-current={isCurrent ? "page" : undefined}
                        >
                            <span class="nav-text">{item.label}</span>
                        </a>
                    );
                })
            }
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = header?.querySelector(".menu-toggle");
    const nav = header?.querySelector(".nav");
    const label = header?.querySelector(".menu-label");

    if (header) {
        const onScroll = () => {
            header.dataset.scrolled = String(window.scrollY > 12);
        };

        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }

    if (
        toggle instanceof HTMLButtonElement &&
        nav instanceof HTMLElement &&
        label instanceof HTMLElement
    ) {
        const setOpen = (open: boolean) => {
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute("aria-label", open ? "Close menu" : "Menu");
            nav.dataset.open = String(open);
            label.textContent = open ? "Close" : "Menu";
        };

        toggle.addEventListener("click", () => {
            setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        nav.addEventListener("click", () => setOpen(false));

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && nav.dataset.open === "true") {
                setOpen(false);
                toggle.focus();
            }
        });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        border-bottom: 1px solid transparent;

        view-transition-name: site-header;

        transition:
            background var(--transition-normal),
            border-color var(--transition-normal);
    }

    .site-header[data-scrolled="true"] {
        background: rgb(13 15 19 / 82%);
        border-bottom-color: var(--line);
        backdrop-filter: blur(14px) saturate(1.3);
    }

    .header-inner {
        min-height: var(--header-height);

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 2rem;
    }

    .brand {
        display: flex;
        align-items: center;

        transition: opacity var(--transition-fast);
    }

    .brand:hover {
        opacity: 0.8;
    }

    .brand-logo {
        width: 210px;
        height: auto;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: clamp(1.25rem, 3vw, 2.5rem);
    }

    .menu-toggle {
        display: none;
    }

    .nav-link {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.95rem;
        letter-spacing: 0.04em;

        transition: color var(--transition-fast);
    }

    .nav-text::before,
    .nav-text::after {
        color: var(--color-purple-bright);

        opacity: 0;
        transition:
            opacity var(--transition-fast),
            margin var(--transition-fast);
    }

    .nav-text::before {
        content: "[";
        margin-right: 0;
    }

    .nav-text::after {
        content: "]";
        margin-left: 0;
    }

    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link[aria-current="page"] {
        color: var(--color-white);
    }

    .nav-link[aria-current="page"] .nav-text::before,
    .nav-link[aria-current="page"] .nav-text::after {
        opacity: 1;
    }

    .nav-link[aria-current="page"] .nav-text::before {
        margin-right: 0.3rem;
    }

    .nav-link[aria-current="page"] .nav-text::after {
        margin-left: 0.3rem;
    }

    @media (max-width: 760px) {
        .site-header {
            background: rgb(13 15 19 / 88%);
            backdrop-filter: blur(14px);
        }

        .header-inner {
            position: relative;
            min-height: 68px;
        }

        .brand-logo {
            width: 170px;
        }

        .nav {
            position: absolute;
            top: calc(100% + 1px);
            right: 0;
            left: 0;

            display: grid;
            gap: 0;

            padding: 0.5rem;

            background: var(--ink-1);
            border: 1px solid var(--line-strong);
            box-shadow: 0 2rem 4rem rgb(0 0 0 / 50%);
        }

        .nav-link {
            min-height: 56px;

            display: flex;
            align-items: center;
            gap: 1rem;

            padding-inline: 0.75rem;

            border-bottom: 1px solid var(--line);

            font-size: 1.15rem;
        }

        .nav-link:last-child {
            border-bottom: 0;
        }

        :global(html.js) .menu-toggle {
            display: inline-flex;
            align-items: center;

            min-height: 44px;
            padding: 0.55rem 0.85rem;

            border: 1px solid var(--line-strong);
            background: transparent;
            color: var(--color-white);

            font-family: var(--font-mono);
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
        }

        .menu-label::before {
            content: "[ ";
            color: var(--color-purple-bright);
        }

        .menu-label::after {
            content: " ]";
            color: var(--color-purple-bright);
        }

        :global(html.js) .nav[data-open="false"] {
            display: none;
        }

        .nav[data-open="true"] {
            animation: menu-in 260ms var(--ease-out) both;
        }

        .nav[data-open="true"] .nav-link {
            animation: menu-item-in 360ms var(--ease-out) both;
        }

        .nav[data-open="true"] .nav-link:nth-child(2) { animation-delay: 40ms; }
        .nav[data-open="true"] .nav-link:nth-child(3) { animation-delay: 80ms; }
        .nav[data-open="true"] .nav-link:nth-child(4) { animation-delay: 120ms; }
    }

    @keyframes menu-in {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
    }

    @keyframes menu-item-in {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
    }

    @media (max-width: 380px) {
        .header-inner {
            gap: 1rem;
        }

        .brand-logo {
            width: 140px;
        }
    }
</style>
