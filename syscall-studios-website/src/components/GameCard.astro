---
interface Props {
    id: string;
    title: string;
    status: string;
    description: string;
    announced: boolean;
    image?: string | null;
    release?: string | null;

    links?: {
        website?: string | null;
        steam?: string | null;
    };
}

const {
    id,
    title,
    status,
    description,
    announced,
    image = null,
    release = null,
    links = {}
} = Astro.props;

const fileNumber = id.replace(/\D/g, "").padStart(2, "0");
---

<article class:list={["game-card", { classified: !announced }]} data-reveal>

    <div class="game-visual">
        {
            image ? (
                <img src={image} alt={`${title} key art`} loading="lazy" decoding="async" />
            ) : (
                <div class="visual-placeholder" aria-hidden="true">
                    <span class="visual-number">{fileNumber}</span>
                    <span class="visual-stamp">Classified</span>
                </div>
            )
        }
    </div>

    <div class="game-content">

        <p class="game-status">
            <span class="status-dot"></span>
            {status}
            {release && <span class="game-release">/ {release}</span>}
        </p>

        <h3>{title}</h3>

        <p class="game-description">{description}</p>

        {
            !announced && (
                <dl class="dossier">
                    <div>
                        <dt>Genre</dt>
                        <dd><span class="redact" aria-label="Redacted">xxxxxxxxxx</span></dd>
                    </div>
                    <div>
                        <dt>Setting</dt>
                        <dd><span class="redact" aria-label="Redacted">xxxxxxxxxxxxxx</span></dd>
                    </div>
                    <div>
                        <dt>Platforms</dt>
                        <dd><span class="redact" aria-label="Redacted">xxxxxxx</span></dd>
                    </div>
                    <div>
                        <dt>Reveal</dt>
                        <dd>When it's ready.</dd>
                    </div>
                </dl>
            )
        }

        {
            announced && (links.website || links.steam) && (
                <div class="game-links">
                    {links.website && (
                        <a href={links.website} class="button button-primary">
                            Website
                        </a>
                    )}

                    {links.steam && (
                        <a
                            href={links.steam}
                            class="button"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Wishlist on Steam
                        </a>
                    )}
                </div>
            )
        }

        {
            !announced && (
                <a href="/devlog/" class="text-link">
                    Updates are in the dev log →
                </a>
            )
        }

    </div>

</article>

<style>
    .game-card {
        display: grid;
        grid-template-columns: 1fr 1fr;

        border: 1px solid var(--line-strong);
        background: var(--ink-1);
    }


    /* Visual */

    .game-visual {
        position: relative;
        overflow: hidden;

        min-height: clamp(280px, 38vw, 480px);

        border-right: 1px solid var(--line-strong);
    }

    .game-visual img {
        width: 100%;
        height: 100%;

        object-fit: cover;
    }

    .visual-placeholder {
        position: absolute;
        inset: 0;

        display: grid;
        place-items: center;

        background:
            repeating-linear-gradient(
                -45deg,
                transparent 0 18px,
                rgb(216 216 216 / 3%) 18px 19px
            ),
            radial-gradient(
                circle at 50% 50%,
                rgb(121 83 245 / 22%),
                transparent 65%
            ),
            var(--ink-0);
    }

    .visual-number {
        color: transparent;

        font-family: var(--font-display);
        font-size: clamp(9rem, 22vw, 18rem);
        font-weight: 900;
        letter-spacing: -0.06em;
        line-height: 1;

        -webkit-text-stroke: 1px rgb(164 141 255 / 55%);
    }

    .visual-stamp {
        position: absolute;
        top: 50%;
        left: 50%;

        padding: 0.4rem 1rem;

        border: 3px solid var(--color-purple-bright);
        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: clamp(1.1rem, 2.4vw, 1.6rem);
        letter-spacing: 0.25em;
        text-transform: uppercase;

        background: rgb(13 15 19 / 70%);
        transform: translate(-50%, -50%) rotate(-8deg);
    }


    /* Content */

    .game-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        padding: clamp(2rem, 4.5vw, 3.5rem);
    }

    .game-status {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        margin-bottom: 1.5rem;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .game-release {
        color: var(--color-muted);
    }

    h3 {
        margin-bottom: 1rem;

        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 900;
        letter-spacing: -0.04em;
    }

    .game-description {
        max-width: 34rem;

        color: var(--color-muted);

        font-size: 1.1rem;
    }

    .dossier {
        width: 100%;

        margin: 1rem 0 2.25rem;

        border-top: 1px solid var(--line);
    }

    .dossier div {
        display: grid;
        grid-template-columns: 7.5rem 1fr;
        gap: 1rem;

        padding-block: 0.85rem;

        border-bottom: 1px solid var(--line);
    }

    .dossier dt {
        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .dossier dd {
        margin: 0;
    }

    .game-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;

        margin-top: 1rem;
    }

    .text-link {
        margin-top: auto;
    }

    @media (max-width: 860px) {
        .game-card {
            grid-template-columns: 1fr;
        }

        .game-visual {
            border-right: 0;
            border-bottom: 1px solid var(--line-strong);
        }
    }
</style>
