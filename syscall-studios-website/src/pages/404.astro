---
import BaseLayout from "../layouts/BaseLayout.astro";
import FindThePage from "../components/FindThePage.astro";
---

<BaseLayout
    title="Page Not Found"
    description="The requested page could not be found."
    noIndex={true}
>
    <section class="error-page">
        <div class="container error-inner">

            <div class="error-copy">
                <p class="eyebrow">404</p>

                <h1>Page not found.</h1>

                <p class="lede">
                    We couldn't find that page. It might have moved, or the
                    link might be wrong.
                </p>

                <p class="error-note">
                    If you followed a link from our site, <a href="/contact/">let us know</a> and we'll fix it.
                </p>

                <div class="error-actions">
                    <a href="/" class="button button-primary">Return Home</a>
                    <a href="/devlog/" class="button">Read the dev log</a>
                </div>
            </div>

            <FindThePage />

        </div>
    </section>
</BaseLayout>

<style>
    .error-page {
        position: relative;
        overflow: hidden;

        min-height: calc(100svh - var(--header-height));

        display: grid;
        align-items: center;

        padding-block: clamp(4rem, 10vw, 8rem);
    }

    .error-page::before {
        position: absolute;
        top: 50%;
        right: -2vw;

        color: rgb(164 141 255 / 6%);

        font-family: var(--font-brand);
        font-size: clamp(12rem, 40vw, 36rem);
        line-height: 1;

        content: "404";
        pointer-events: none;
        transform: translateY(-50%);
    }

    .error-inner {
        position: relative;

        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(3rem, 6vw, 6rem);
    }

    @media (max-width: 900px) {
        .error-inner {
            grid-template-columns: 1fr;
        }
    }

    h1 {
        margin-bottom: 2rem;
    }

    .error-copy .lede {
        margin-bottom: 1rem;
    }

    .error-note {
        margin-bottom: 2.5rem;

        color: var(--color-muted);
    }

    .error-note a {
        color: var(--color-purple-bright);

        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .error-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
</style>
