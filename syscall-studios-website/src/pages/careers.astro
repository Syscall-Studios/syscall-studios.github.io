---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";

const openRoles: { title: string; description: string }[] = [];

const promises = [
    {
        title: "No unpaid \u201Cinternships.\u201D",
        body: "If someone does real work on our game, they get paid real money for it. Exposure has never once covered rent."
    },
    {
        title: "No revenue-share fantasies.",
        body: "We won't offer you half a percent of a game that doesn't exist yet and call it a salary."
    },
    {
        title: "No fake job posts.",
        body: "We're not going to list roles just to look bigger than we are. If a job shows up here, it's real and there's money set aside for it."
    }
];
---

<BaseLayout
    title="Careers"
    description="Syscall Studios is not hiring yet. Here's why, and what we promise for when we are."
>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Careers</p>

            <h1>We can't afford you. Yet.</h1>

            <p class="lede">
                That's pretty much the whole page. But since you're here,
                here's the longer version.
            </p>
        </div>
    </section>


    <section class="roles section">
        <div class="container roles-grid">

            <div>
                <p class="eyebrow">Open roles</p>
                <h2 data-reveal>Current openings.</h2>
            </div>

            {
                openRoles.length > 0 ? (
                    <div class="roles-list">
                        {openRoles.map((role, index) => (
                            <article class="role">
                                <span class="role-number">0{index + 1}</span>
                                <div>
                                    <h3>{role.title}</h3>
                                    <p>{role.description}</p>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="roles-empty" data-reveal>
                        <div class="roles-box">
                            <p class="roles-count">None right now.</p>
                            <p class="status-line">
                                <span class="status-dot"></span>
                                Not hiring
                            </p>
                        </div>

                        <p>
                            Not &ldquo;none, but send us your CV anyway so it can
                            sit in a folder nobody opens.&rdquo; Actually none.
                        </p>
                    </div>
                )
            }

        </div>
    </section>


    <section class="math section">
        <div class="container math-grid">

            <div>
                <p class="eyebrow">The money</p>
                <h2 data-reveal>Why we're not hiring.</h2>
            </div>

            <div class="math-copy" data-reveal style="--reveal-index: 1">
                <p>
                    We pay for everything ourselves, and right now there's
                    no money for salaries.
                </p>

                <p>
                    Every dollar we have is going into our first game. So far
                    it's paid us back mostly in bug reports.
                </p>

                <p>
                    If we hire someone, we want to pay them properly. Until
                    we can, we'd rather not pretend otherwise.
                </p>
            </div>

        </div>
    </section>


    <section class="promises section">
        <div class="container">

            <p class="eyebrow">When we do hire</p>
            <h2 class="promises-title" data-reveal>Things we won't do.</h2>

            <div class="promise-grid">
                {
                    promises.map((promise, index) => (
                        <article class="promise" data-reveal style={`--reveal-index: ${index}`}>
                            <span class="promise-number">0{index + 1}</span>
                            <h3>{promise.title}</h3>
                            <p>{promise.body}</p>
                        </article>
                    ))
                }
            </div>

        </div>
    </section>


    <section class="future section">
        <div class="container future-grid">

            <h2 data-reveal>Check back eventually.</h2>

            <div class="future-copy" data-reveal style="--reveal-index: 1">
                <p>
                    When that changes, this page will be the first place
                    it shows up. We'll probably write about it in the dev
                    log too.
                </p>

                <p class="muted">
                    In the meantime, you're welcome to say hi or introduce
                    yourself. You don't need a portfolio, but we'll happily
                    look at one.
                </p>

                <a class="future-email" href={`mailto:${site.emails.hello}`}>
                    {site.emails.hello}
                </a>
            </div>

        </div>
    </section>

</BaseLayout>

<style>
    .roles-grid,
    .math-grid,
    .future-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
    }

    .roles-empty > p {
        max-width: 34rem;
        margin: 1.5rem 0 0;

        color: var(--color-muted);

        font-size: 1.15rem;
    }

    .roles-box {
        padding: 1.5rem;

        border: 1px solid var(--line-strong);
        background: var(--ink-1);
    }

    .roles-count {
        margin: 0;

        color: var(--color-white);

        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.015em;
    }

    .status-line {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        margin: 1.25rem 0 0 !important;
        padding-top: 1rem;

        border-top: 1px dashed var(--line-strong);
        color: var(--color-purple-bright);

        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .roles-list {
        border-top: 1px solid var(--line-strong);
    }

    .role {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: 1.5rem;

        padding-block: 2rem;

        border-bottom: 1px solid var(--line-strong);
    }

    .role-number {
        color: var(--color-purple-bright);
        font-family: var(--font-mono);
    }

    .role p {
        margin-bottom: 0;
        color: var(--color-muted);
    }

    .math-copy {
        color: var(--color-muted);
        font-size: 1.2rem;
    }

    .math-copy p:first-child {
        color: var(--color-white);
        font-size: clamp(1.4rem, 2.4vw, 1.8rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.3;
    }

    .promises-title {
        margin-bottom: clamp(3rem, 6vw, 5rem);
    }

    .promise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    .promise {
        padding: clamp(1.75rem, 3vw, 2.5rem);

        border: 1px solid var(--line-strong);
        background: var(--ink-1);
    }

    .promise-number {
        display: block;

        margin-bottom: 3rem;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
    }

    .promise h3 {
        margin-bottom: 1rem;
    }

    .promise p {
        margin-bottom: 0;
        color: var(--color-muted);
    }

    .future {
        background:
            radial-gradient(
                ellipse 60% 80% at 0% 100%,
                rgb(121 83 245 / 16%),
                transparent 70%
            );
    }

    .future-copy {
        font-size: 1.15rem;
    }

    .future-email {
        display: inline-block;

        margin-top: 0.5rem;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: clamp(1rem, 2vw, 1.25rem);

        word-break: break-word;

        background:
            linear-gradient(currentColor, currentColor)
            0 100% / 100% 1px no-repeat;
    }

    @media (max-width: 900px) {
        .promise-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 820px) {
        .roles-grid,
        .math-grid,
        .future-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
