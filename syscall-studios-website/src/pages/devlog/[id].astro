---
import {
    getCollection,
    render
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format-date";


export async function getStaticPaths() {
    const posts = await getCollection(
        "devlog",
        ({ data }) => !data.draft
    );

    return posts.map((post) => ({
        params: {
            id: post.id
        },

        props: {
            post
        }
    }));
}


const { post } = Astro.props;

const { Content } = await render(post);

const formattedDate = formatDate(post.data.pubDate, "long");
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
>
    <article>

        <header class="article-header">
            <div class="article-container">

                <a
                    href="/devlog"
                    class="back"
                >
                    ← DEVLOG
                </a>

                <p class="eyebrow">
                    DEVLOG | {formattedDate}
                </p>

                <h1>
                    {post.data.title}
                </h1>

                <p class="description">
                    {post.data.description}
                </p>

                {
                    post.data.tags.length > 0 && (
                        <div class="tags">
                            {
                                post.data.tags.map((tag) => (
                                    <span>[ {tag} ]</span>
                                ))
                            }
                        </div>
                    )
                }

            </div>
        </header>


        <section class="article-body">
            <div class="prose">
                <Content />
            </div>
        </section>

    </article>
</BaseLayout>

<style>
    .article-container,
    .prose {
        width: min(
            calc(100% - (var(--page-padding) * 2)),
            820px
        );

        margin-inline: auto;
    }


    /* Header */

    .article-header {
        padding-top: clamp(5rem, 10vw, 9rem);
        padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .back {
        display: inline-block;

        margin-bottom: 4rem;

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.8rem;

        transition: color var(--transition-fast);
    }

    .back:hover,
    .back:focus-visible {
        color: var(--color-purple);
    }

    .article-header h1 {
        margin-bottom: 2rem;

        font-size: clamp(2.5rem, 6vw, 5rem);
    }

    .description {
        max-width: 650px;

        color: var(--color-muted);

        font-size: 1.25rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;

        margin-top: 2rem;

        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.75rem;
    }


    /* Article */

    .article-body {
        padding-block: clamp(4rem, 8vw, 7rem);

        background: var(--color-white);
        color: var(--color-slate);
    }


    /* Markdown Styling */

    .prose {
        font-size: 1.1rem;
        line-height: 1.8;
    }

    .prose :global(h2) {
        margin-top: 4rem;
        margin-bottom: 1.25rem;

        font-size: clamp(2.5rem, 5vw, 4rem);
    }

    .prose :global(h3) {
        margin-top: 3rem;
        margin-bottom: 1rem;

        font-size: clamp(2rem, 4vw, 3rem);
    }

    .prose :global(p) {
        margin-bottom: 1.5rem;
    }

    .prose :global(a) {
        color: var(--color-purple);

        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
    }

    .prose :global(strong) {
        font-weight: 600;
    }

    .prose :global(blockquote) {
        margin: 2.5rem 0;
        padding-left: 1.5rem;

        border-left: 3px solid var(--color-purple);

        color: rgb(67 75 87 / 75%);
    }

    .prose :global(code) {
        padding: 0.15rem 0.35rem;

        background: var(--color-gray);

        font-family: var(--font-mono);
        font-size: 0.9em;
    }

    .prose :global(pre) {
        overflow-x: auto;

        padding: 1.5rem;

        background: var(--color-slate);
        color: var(--color-white);
    }

    .prose :global(pre code) {
        padding: 0;

        background: none;
    }

    .prose :global(img) {
        width: 100%;

        margin-block: 3rem;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 0 0 1.5rem;
        padding-left: 1.25rem;
    }

    .prose :global(li) {
        margin-bottom: 0.5rem;
    }

    .prose :global(pre) {
        margin-block: 2rem;
    }

    .prose :global(hr) {
        margin-block: 4rem;

        border: 0;
        border-top: 1px solid var(--color-gray);
    }
</style>