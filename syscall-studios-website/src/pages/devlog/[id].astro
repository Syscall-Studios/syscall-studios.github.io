---
import {
    getCollection,
    render
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format-date";
import { getPublishedPosts } from "../../lib/devlog";
import { blogPosting } from "../../lib/seo";


export async function getStaticPaths() {
    const posts = await getCollection(
        "devlog",
        ({ data }) => !data.draft
    );

    return posts.map((post) => ({
        params: {
            id: post.id
        },

        props: {
            post
        }
    }));
}


const { post } = Astro.props;

const { Content, headings } = await render(post);

const formattedDate = formatDate(post.data.pubDate, "long");

const allPosts = await getPublishedPosts();
const position = allPosts.findIndex((entry) => entry.id === post.id);
const newer = position > 0 ? allPosts[position - 1] : null;
const older = position < allPosts.length - 1 ? allPosts[position + 1] : null;

const sections = headings.filter((heading) => heading.depth === 2);

const origin = Astro.site ?? Astro.url;
---

<BaseLayout
    title={post.data.seoTitle ?? post.data.title}
    description={post.data.description}
    image={post.data.cover}
    imageAlt={post.data.cover ? post.data.title : undefined}
    breadcrumbs={[
        { name: "Dev Log", path: "/devlog/" },
        { name: post.data.title, path: `/devlog/${post.id}/` }
    ]}
    article={{
        publishedTime: post.data.pubDate,
        modifiedTime: post.data.updatedDate,
        tags: post.data.tags
    }}
    structuredData={[blogPosting(origin, post, post.body)]}
>
    <article>

        <header class="article-header page-hero">
            <div class="article-container">

                <a href="/devlog/" class="back">← All posts</a>

                <p class="eyebrow">
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                </p>

                <h1>{post.data.title}</h1>

                <p class="lede">{post.data.description}</p>

                {
                    post.data.tags.length > 0 && (
                        <ul class="tags">
                            {post.data.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                    )
                }

            </div>
        </header>


        <div class="article-body">
            {
                sections.length > 1 && (
                    <nav class="toc" aria-label="In this post">
                        <p class="toc-heading">In this post</p>
                        <ol>
                            {sections.map((heading) => (
                                <li>
                                    <a href={`#${heading.slug}`}>{heading.text}</a>
                                </li>
                            ))}
                        </ol>
                    </nav>
                )
            }

            <div class="prose">
                <Content />
            </div>
        </div>


        <footer class="article-footer">
            <div class="article-container">
                <nav class="pager" aria-label="More posts">
                    {
                        older ? (
                            <a href={`/devlog/${older.id}/`} class="pager-link">
                                <span>← Older</span>
                                {older.data.title}
                            </a>
                        ) : (
                            <span class="pager-link is-empty">
                                <span>← Older</span>
                                This is the first post.
                            </span>
                        )
                    }

                    {
                        newer ? (
                            <a href={`/devlog/${newer.id}/`} class="pager-link pager-next">
                                <span>Newer →</span>
                                {newer.data.title}
                            </a>
                        ) : (
                            <span class="pager-link pager-next is-empty">
                                <span>Newer →</span>
                                Nothing newer yet.
                            </span>
                        )
                    }
                </nav>
            </div>
        </footer>

    </article>
</BaseLayout>

<style>
    .article-container,
    .prose {
        width: min(
            calc(100% - (var(--page-padding) * 2)),
            46rem
        );

        margin-inline: auto;
    }


    /* Header */

    .article-header {
        padding-bottom: clamp(3rem, 6vw, 5rem);
        border-bottom: 1px solid var(--line);
    }

    .article-container {
        position: relative;
    }

    .back {
        display: block;
        width: fit-content;

        margin-bottom: 3rem;

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;

        transition: color var(--transition-fast);
    }

    .back:hover,
    .back:focus-visible {
        color: var(--color-purple-bright);
    }

    .article-header h1 {
        max-width: none;
        margin-bottom: 1.75rem;

        font-size: clamp(3rem, 7vw, 5.5rem);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin: 2rem 0 0;
        padding: 0;

        list-style: none;
    }

    .tags li {
        padding: 0.3rem 0.7rem;

        border: 1px solid var(--line-strong);
        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .tags li::before {
        content: "#";
        color: var(--color-purple-bright);
    }


    /* Body */

    .article-body {
        position: relative;

        padding-block: clamp(3.5rem, 7vw, 6rem);
    }

    .toc {
        position: absolute;
        top: clamp(3.5rem, 7vw, 6rem);
        bottom: 0;
        left: max(var(--page-padding), calc(50% - 23rem - 18rem));

        width: 14rem;
    }

    .toc ol {
        position: sticky;
        top: calc(var(--header-height) + 2rem);

        display: grid;
        gap: 0.6rem;

        margin: 0;
        padding: 0;

        list-style: none;
        counter-reset: toc;
    }

    .toc-heading {
        margin-bottom: 1rem;

        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .toc li {
        counter-increment: toc;
    }

    .toc a {
        display: flex;
        gap: 0.6rem;

        color: var(--color-muted);

        font-size: 0.95rem;
        line-height: 1.35;

        transition: color var(--transition-fast);
    }

    .toc a::before {
        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.6;

        content: counter(toc, decimal-leading-zero);
    }

    .toc a:hover,
    .toc a:focus-visible {
        color: var(--color-white);
    }

    @media (max-width: 1240px) {
        .toc {
            display: none;
        }
    }


    /* Markdown Styling */

    .prose {
        color: #d4d7dd;

        font-size: 1.2rem;
        line-height: 1.75;
    }

    .prose :global(h2) {
        margin-top: 4.5rem;
        margin-bottom: 1.25rem;

        color: var(--color-white);

        font-size: clamp(2rem, 4vw, 2.9rem);
        scroll-margin-top: calc(var(--header-height) + 1.5rem);
    }

    .prose :global(h2)::before {
        display: block;

        width: 2rem;
        height: 3px;

        margin-bottom: 1.25rem;

        background: var(--color-purple-bright);

        content: "";
    }

    .prose :global(h3) {
        margin-top: 3rem;
        margin-bottom: 1rem;

        color: var(--color-white);

        font-size: clamp(1.5rem, 3vw, 2rem);
    }

    .prose :global(p) {
        margin-bottom: 1.4rem;
    }

    .prose :global(a) {
        color: var(--color-purple-bright);

        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
    }

    .prose :global(strong) {
        color: var(--color-white);
        font-weight: 700;
    }

    .prose :global(blockquote) {
        margin: 2.5rem 0;
        padding-left: 1.5rem;

        border-left: 3px solid var(--color-purple-bright);

        color: var(--color-white);

        font-size: 1.35rem;
        font-style: italic;
    }

    .prose :global(code) {
        padding: 0.1rem 0.4rem;

        border: 1px solid var(--line-strong);
        background: var(--ink-2);
        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.85em;
    }

    .prose :global(pre) {
        overflow-x: auto;

        margin-block: 2rem;
        padding: 1.5rem;

        border: 1px solid var(--line-strong);
        background: var(--ink-1) !important;
    }

    .prose :global(pre code) {
        padding: 0;

        border: 0;
        background: none;
        color: inherit;
    }

    .prose :global(img) {
        width: 100%;

        margin-block: 3rem;

        border: 1px solid var(--line-strong);
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 0 0 1.5rem;
        padding-left: 1.25rem;
    }

    .prose :global(li) {
        margin-bottom: 0.5rem;
    }

    .prose :global(li::marker) {
        color: var(--color-purple-bright);
    }

    .prose :global(hr) {
        margin-block: 4rem;

        border: 0;
        border-top: 1px solid var(--line-strong);
    }


    /* Footer */

    .article-footer {
        padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .pager {
        padding-top: 2.5rem;

        border-top: 1px solid var(--line-strong);

        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .pager-link {
        display: grid;
        gap: 0.5rem;

        padding: 1.5rem;

        border: 1px solid var(--line-strong);

        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.25;

        transition:
            border-color var(--transition-fast),
            background var(--transition-fast);
    }

    .pager-link span {
        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    a.pager-link:hover,
    a.pager-link:focus-visible {
        border-color: var(--color-purple-bright);
        background: var(--ink-1);
    }

    .pager-next {
        text-align: right;
    }

    .pager-link.is-empty {
        border-style: dashed;
        color: var(--color-dim);
    }

    .pager-link.is-empty span {
        color: var(--color-dim);
    }

    @media (max-width: 600px) {
        .pager {
            grid-template-columns: 1fr;
        }

        .pager-next {
            text-align: left;
        }
    }
</style>
