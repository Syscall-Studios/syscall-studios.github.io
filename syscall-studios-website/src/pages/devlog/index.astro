---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DevlogCard from "../../components/DevlogCard.astro";
import { getPublishedPosts } from "../../lib/devlog";

const posts = await getPublishedPosts();
---

<BaseLayout
    title="Dev Log"
    description="Development notes, experiments, mistakes and discoveries from Syscall Studios."
>
    <section class="page-hero">
        <div class="container hero-grid">

            <div>
                <p class="eyebrow">Dev log</p>

                <h1>From the workbench.</h1>

                <p class="lede">
                    What we built, what broke, and what we learned along the
                    way. Expect posts about design, tech, art, running a tiny
                    studio, and whatever weird problem ate our week.
                </p>
            </div>

            <div class="feed-box">
                <p class="feed-count">
                    <span class="mono accent">{posts.length}</span>
                    {posts.length === 1 ? "post so far" : "posts so far"}
                </p>

                <a href="/rss.xml" class="text-link">Subscribe via RSS →</a>
            </div>

        </div>
    </section>


    <section class="devlog-list section">
        <div class="container">

            {
                posts.length > 0 ? (
                    posts.map((post) => (
                        <DevlogCard
                            id={post.id}
                            title={post.data.title}
                            description={post.data.description}
                            pubDate={post.data.pubDate}
                            tags={post.data.tags}
                        />
                    ))
                ) : (
                    <p class="empty mono">Nothing posted yet.</p>
                )
            }

        </div>
    </section>

</BaseLayout>

<style>
    .hero-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 3rem;
    }

    .feed-box {
        display: grid;
        gap: 0.75rem;

        min-width: 14rem;
        padding: 1.5rem;

        border: 1px solid var(--line-strong);
        background: rgb(19 22 27 / 70%);
    }

    .feed-count {
        margin: 0;

        color: var(--color-muted);
    }

    .feed-count .mono {
        display: block;

        margin-bottom: 0.25rem;

        font-size: 2.5rem;
        line-height: 1;
    }

    .devlog-list {
        padding-top: clamp(2rem, 5vw, 4rem);
    }

    .empty {
        color: var(--color-purple-bright);
    }

    @media (max-width: 760px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
