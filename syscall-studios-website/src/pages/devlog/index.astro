---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import DevlogCard from "../../components/DevlogCard.astro";

const posts = (
    await getCollection(
        "devlog",
        ({ data }) => !data.draft
    )
).sort(
    (a, b) =>
        b.data.pubDate.valueOf() -
        a.data.pubDate.valueOf()
);
---

<BaseLayout
    title="Dev Log"
    description="Development notes, experiments and updates from Syscall Studios."
>
    <section class="devlog-hero">
        <div class="container">

            <p class="eyebrow">
                SYS::DEVLOG
            </p>

            <h1>
                From the<br />
                Workbench.
            </h1>

            <p class="intro">
                Development notes, experiments, mistakes,
                discoveries, and occasional successful builds
                from Syscall Studios.
            </p>

        </div>
    </section>


    <section class="devlog-list">
        <div class="container">

            {
                posts.length > 0 ? (
                    posts.map((post) => (
                        <DevlogCard
                            id={post.id}
                            title={post.data.title}
                            description={post.data.description}
                            pubDate={post.data.pubDate}
                            tags={post.data.tags}
                        />
                    ))
                ) : (
                    <p class="empty">
                        No transmissions found.
                    </p>
                )
            }

        </div>
    </section>

</BaseLayout>

<style>
    .devlog-hero {
        padding-top: clamp(6rem, 12vw, 11rem);
        padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .devlog-hero h1 {
        margin-bottom: 2rem;

        font-size: clamp(4rem, 10vw, 8rem);
    }

    .intro {
        max-width: 640px;

        margin-bottom: 0;

        color: var(--color-muted);

        font-size: clamp(1.1rem, 2vw, 1.35rem);
    }

    .devlog-list {
        padding-block: clamp(4rem, 8vw, 7rem);

        background: var(--color-white);
        color: var(--color-slate);
    }

    .empty {
        font-family: var(--font-mono);
        color: var(--color-purple);
    }
</style>