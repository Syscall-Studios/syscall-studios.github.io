---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="About"
    description="About Syscall Studios — an independent game studio building thoughtful, systems-driven games."
>

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="about-hero">
        <div class="container">

            <p class="eyebrow">
                SYS::ABOUT
            </p>

            <h1>
                Small studio.<br />
                Big curiosity.
            </h1>

            <p class="hero-copy">
                Syscall Studios is an independent game studio focused
                on thoughtful systems, tactile interactions, and worlds
                that reward players for paying attention.
            </p>

        </div>
    </section>


    <!-- =====================================================
         INTRO
         ===================================================== -->

    <section class="intro-section section">
        <div class="container intro-grid">

            <div class="intro-heading">
                <p class="eyebrow">
                    WHO WE ARE
                </p>

                <h2>
                    Games made with intention.
                </h2>
            </div>

            <div class="intro-copy">

                <p>
                    We're a small independent studio interested in games
                    where understanding how something works is part of
                    the experience.
                </p>

                <p>
                    We like systems that interact, environments that feel
                    lived in, and mechanics that encourage experimentation
                    instead of constantly telling the player what to do.
                </p>

                <p>
                    Our first game is currently in development.
                    We're not ready to talk about it just yet.
                </p>

            </div>

        </div>
    </section>


    <!-- =====================================================
         PRINCIPLES
         ===================================================== -->

    <section class="principles section">
        <div class="container">

            <p class="eyebrow">
                STUDIO::PRINCIPLES
            </p>

            <div class="principles-heading">
                <h2>
                    What matters to us.
                </h2>
            </div>

            <div class="principles-grid">

                <article class="principle">
                    <span class="principle-number">
                        01
                    </span>

                    <h3>
                        Curiosity
                    </h3>

                    <p>
                        We want players to ask questions, experiment,
                        investigate, and understand the systems around them.
                    </p>
                </article>


                <article class="principle">
                    <span class="principle-number">
                        02
                    </span>

                    <h3>
                        Believability
                    </h3>

                    <p>
                        A world doesn't have to be photorealistic to feel
                        convincing. Small details, consistent rules, and
                        thoughtful interactions go a long way.
                    </p>
                </article>


                <article class="principle">
                    <span class="principle-number">
                        03
                    </span>

                    <h3>
                        Simplicity
                    </h3>

                    <p>
                        Good design doesn't need unnecessary complexity.
                        We aim for experiences that are approachable without
                        stripping away depth.
                    </p>
                </article>

            </div>

        </div>
    </section>


    <!-- =====================================================
         THE NAME
         ===================================================== -->

    <section class="origin section">
        <div class="container origin-grid">

            <div class="origin-mark">

                <img
                    src="/brand/logo-mark-light.svg"
                    alt="Syscall Studios 0x80 mark"
                />

            </div>


            <div class="origin-copy">

                <p class="eyebrow">
                    WHY // SYSCALL
                </p>

                <h2>
                    int 0x80
                </h2>

                <p>
                    In classic 32-bit Linux, <code>int 0x80</code> was a way for a program to request a service from the operating system kernel — a system call.
                </p>

                <p>
                    It's a small piece of computing history that felt
                    appropriate for a studio interested in systems,
                    technology, and understanding what happens beneath
                    the surface.
                </p>

                <div class="terminal-line">
                    <span class="prompt">&gt;</span>
                    <span>invoke creativity</span>
                    <span class="cursor"></span>
                </div>

            </div>

        </div>
    </section>


    <!-- =====================================================
         CURRENT STATUS
         ===================================================== -->

    <section class="current section">
        <div class="container current-inner">

            <div>
                <p class="eyebrow">
                    CURRENT::STATUS
                </p>

                <h2>
                    Building<br />
                    Project 01.
                </h2>
            </div>

            <div class="current-copy">

                <div class="status-line">
                    <span class="status-dot"></span>
                    <span>IN DEVELOPMENT</span>
                </div>

                <p>
                    Our first title is currently in active development.
                    We'll share more when it's ready.
                </p>

                <a
                    href="/devlog"
                    class="button"
                >
                    Follow Development
                </a>

            </div>

        </div>
    </section>

</BaseLayout>


<style>

    /* =====================================================
       HERO
       ===================================================== */

    .about-hero {
        padding-top: clamp(7rem, 13vw, 12rem);
        padding-bottom: clamp(5rem, 10vw, 9rem);
    }

    .about-hero h1 {
        max-width: 1000px;

        margin-bottom: 2.5rem;

        font-size: clamp(4.5rem, 11vw, 9rem);
    }

    .hero-copy {
        max-width: 700px;

        margin-bottom: 0;

        color: var(--color-muted);

        font-size: clamp(1.15rem, 2vw, 1.4rem);
    }


    /* =====================================================
       INTRO
       ===================================================== */

    .intro-section {
        background: var(--color-white);
        color: var(--color-slate);
    }

    .intro-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;

        gap: clamp(4rem, 10vw, 9rem);
    }

    .intro-heading h2 {
        max-width: 600px;

        margin-bottom: 0;
    }

    .intro-copy {
        align-self: end;

        max-width: 560px;

        font-size: 1.15rem;
    }

    .intro-copy p:last-child {
        margin-bottom: 0;
    }


    /* =====================================================
       PRINCIPLES
       ===================================================== */

    .principles-heading {
        max-width: 750px;

        margin-bottom: 4rem;
    }

    .principles-heading h2 {
        margin-bottom: 0;
    }

    .principles-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        border-top: 1px solid rgb(216 216 216 / 20%);
    }

    .principle {
        min-height: 340px;

        padding: 2.5rem;

        border-right: 1px solid
            rgb(216 216 216 / 20%);
    }

    .principle:first-child {
        border-left: 1px solid
            rgb(216 216 216 / 20%);
    }

    .principle-number {
        display: block;

        margin-bottom: 5rem;

        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
    }

    .principle h3 {
        margin-bottom: 1.25rem;

        font-size: clamp(2.2rem, 4vw, 3.25rem);
    }

    .principle p {
        max-width: 340px;

        margin-bottom: 0;

        color: var(--color-muted);
    }


    /* =====================================================
       ORIGIN
       ===================================================== */

    .origin {
        background:
            linear-gradient(
                135deg,
                rgb(121 83 245 / 11%),
                transparent 45%
            );
    }

    .origin-grid {
        display: grid;
        grid-template-columns: minmax(250px, 0.8fr) 1.2fr;

        align-items: center;

        gap: clamp(4rem, 10vw, 10rem);
    }

    .origin-mark {
        display: flex;
        justify-content: center;
        align-items: center;

        min-height: 400px;

        border: 1px solid
            rgb(216 216 216 / 15%);
    }

    .origin-mark img {
        width: min(260px, 65%);
    }

    .origin-copy {
        max-width: 650px;
    }

    .origin-copy h2 {
        margin-bottom: 2rem;

        font-family: var(--font-mono);
        font-size: clamp(3.5rem, 7vw, 6rem);
    }

    .origin-copy p {
        color: var(--color-muted);

        font-size: 1.1rem;
    }

    .origin-copy code {
        color: var(--color-purple);

        font-family: var(--font-mono);
    }


    /* Terminal */

    .terminal-line {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        margin-top: 3rem;
        padding: 1rem 1.25rem;

        border: 1px solid
            rgb(216 216 216 / 18%);

        font-family: var(--font-mono);
        font-size: 0.9rem;
    }

    .prompt {
        color: var(--color-purple);
    }

    .cursor {
        width: 8px;
        height: 1rem;

        background: var(--color-purple);

        animation: blink 1.1s step-end infinite;
    }

    @keyframes blink {
        0%,
        50% {
            opacity: 1;
        }

        51%,
        100% {
            opacity: 0;
        }
    }


    /* =====================================================
       CURRENT STATUS
       ===================================================== */

    .current {
        background: var(--color-white);
        color: var(--color-slate);
    }

    .current-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;

        gap: clamp(4rem, 10vw, 9rem);
    }

    .current h2 {
        margin-bottom: 0;
    }

    .current-copy {
        align-self: end;

        max-width: 520px;
    }

    .status-line {
        display: flex;
        align-items: center;
        gap: 0.7rem;

        margin-bottom: 1.5rem;

        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
    }

    .status-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: var(--color-purple);

        box-shadow:
            0 0 12px rgb(121 83 245 / 55%);
    }

    .current-copy p {
        margin-bottom: 2rem;

        font-size: 1.1rem;
    }

    .current-copy .button {
        color: var(--color-slate);
        border-color: var(--color-slate);
    }

    .current-copy .button:hover {
        color: var(--color-white);
        border-color: var(--color-purple);
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 850px) {

        .intro-grid,
        .origin-grid,
        .current-inner {
            grid-template-columns: 1fr;
        }

        .principles-grid {
            grid-template-columns: 1fr;
        }

        .principle {
            min-height: auto;

            border-left: 1px solid
                rgb(216 216 216 / 20%);
            border-bottom: 1px solid
                rgb(216 216 216 / 20%);
        }

        .principle-number {
            margin-bottom: 3rem;
        }

        .origin-mark {
            min-height: 300px;
        }
    }


    /* Respect reduced motion */

    @media (prefers-reduced-motion: reduce) {
        .cursor {
            animation: none;
        }
    }

</style>