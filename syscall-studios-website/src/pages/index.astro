---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemField from "../components/SystemField.astro";
import GameCard from "../components/GameCard.astro";
import DevlogCard from "../components/DevlogCard.astro";
import games from "../data/games.json";
import { getPublishedPosts } from "../lib/devlog";

const featuredGame = games.find((game) => game.featured) ?? games[0];

const latestPosts = (await getPublishedPosts()).slice(0, 2);

const arc = [
    { name: "Confusion", line: "Something you don't understand yet." },
    { name: "Curiosity", line: "You poke at it." },
    { name: "Experimentation", line: "You form a theory and test it." },
    { name: "Understanding", line: "\u201COhhh. That's why that happened.\u201D" },
    { name: "Competence", line: "You stop reacting and start predicting." },
    { name: "Mastery", line: "You bend the system on purpose." },
    { name: "Creativity", line: "You do something we never planned for." }
];

const principles = [
    {
        title: "Give players a toolbox.",
        body: "We'd rather hand you tools, rules and feedback and see what you do with them than walk you through a checklist."
    },
    {
        title: "Keep the actions simple.",
        body: "Picking something up or flipping a switch shouldn't need a tutorial. The interesting part is what happens because you did it."
    },
    {
        title: "Make the rules readable.",
        body: "Randomness and hidden information are fine. A game that seems to screw you over for no reason isn't. You should be able to work out why something happened."
    },
    {
        title: "Let knowledge be the upgrade.",
        body: "Some of the best progress in a game happens in your head, like when you spot a bottleneck early or finally get how two systems affect each other."
    },
    {
        title: "Make places feel lived in.",
        body: "Real places pile up repairs, scuffs, sticky notes and temporary fixes nobody got around to replacing. We want our worlds to have that kind of history."
    },
    {
        title: "Treat atmosphere as part of the game.",
        body: "Lighting, sound, weather and clutter should change with what's happened, so you can look around and see what you did."
    }
];
---

<BaseLayout>

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="hero" data-field-area>
        <SystemField />

        <div class="hero-shade" aria-hidden="true"></div>

        <div class="container hero-inner">
            <p class="hero-kicker" data-boot>
                <span class="status-dot"></span>
                Independent game studio
            </p>

            <h1 data-boot style="--boot: 1">
                <span class="visually-hidden">Syscall Studios: </span>
                Make systems<br />
                worth <span class="accent">understanding.</span>
            </h1>

            <p class="lede" data-boot style="--boot: 3">
                We make games about figuring out how things work, and
                the moment it finally clicks.
            </p>

            <div class="hero-actions" data-boot style="--boot: 4">
                <a href="#project" class="button button-primary">
                    What we're building
                </a>

                <a href="/about/" class="button">
                    How we think
                </a>
            </div>
        </div>

        <a href="#belief" class="scroll-cue" data-boot style="--boot: 7">
            <span class="scroll-line" aria-hidden="true"></span>
            Scroll
        </a>
    </section>


    <!-- =====================================================
         CORE BELIEF
         ===================================================== -->

    <section class="belief" id="belief">
        <div class="container">
            <p class="eyebrow belief-eyebrow">What we believe</p>

            <blockquote class="belief-quote" data-reveal>
                <p class="belief-setup">
                    We don't want to impress you with how clever we are.
                </p>

                <p class="belief-punch">
                    We want to build games that let you discover how
                    clever <em>you</em> can be.
                </p>
            </blockquote>
        </div>
    </section>


    <!-- =====================================================
         PLAYER ARC
         ===================================================== -->

    <section class="arc section">
        <div class="container">

            <div class="split-head">
                <div>
                    <p class="eyebrow">How it should feel</p>
                    <h2 data-reveal>Confusion is where it starts.</h2>
                </div>

                <div class="split-copy" data-reveal style="--reveal-index: 1">
                    <p>
                        A lot of our favorite moments in games follow roughly
                        the same path. Not every mechanic has to go through
                        every step, but we want learning to make you better
                        at the game, not just bump up a number.
                    </p>

                    <p class="muted arc-aside">
                        If you clicked around at the top of the page, you've
                        already done the first three.
                    </p>
                </div>
            </div>

            <ol class="arc-steps" data-reveal>
                {
                    arc.map((stage, index) => (
                        <li class="arc-step" style={`--step: ${index}`}>
                            <span class="step-node" aria-hidden="true"></span>
                            <span class="step-number">0{index + 1}</span>
                            <h3>{stage.name}</h3>
                            <p>{stage.line}</p>
                        </li>
                    ))
                }
            </ol>

        </div>
    </section>


    <!-- =====================================================
         PRINCIPLES
         ===================================================== -->

    <section class="principles section">
        <div class="container">

            <div class="split-head">
                <div>
                    <p class="eyebrow">What we care about</p>
                    <h2 data-reveal>What carries over from game to game.</h2>
                </div>

                <p class="split-copy" data-reveal style="--reveal-index: 1">
                    We don't want to be the studio that only makes one kind
                    of game. The genre and art style will change. The way
                    we approach each game shouldn't, and it looks
                    something like this.
                </p>
            </div>

            <div class="principle-grid">
                {
                    principles.map((principle, index) => (
                        <article
                            class="principle"
                            data-reveal
                            style={`--reveal-index: ${index % 3}`}
                        >
                            <span class="principle-label">0{index + 1}</span>
                            <h3>{principle.title}</h3>
                            <p>{principle.body}</p>
                        </article>
                    ))
                }

                <article class="principle principle-filter" data-reveal>
                    <span class="principle-label">Most important</span>
                    <div>
                        <h3>None of it matters if the game isn't fun.</h3>
                        <p>
                            A clever simulation that's a chore to play is a
                            failed game. Everything else on this list is
                            there to make the game more fun, not the other
                            way around.
                        </p>
                    </div>
                </article>
            </div>

        </div>
    </section>


    <!-- =====================================================
         CURRENT PROJECT
         ===================================================== -->

    <section class="project section" id="project">
        <div class="container">

            <div class="split-head">
                <div>
                    <p class="eyebrow">What we're working on</p>
                    <h2 data-reveal>Our first game.</h2>
                </div>

                <p class="split-copy" data-reveal style="--reveal-index: 1">
                    Right now we're prototyping the risky parts and making
                    sure the core loop is actually fun before we build out
                    the rest. We'll show it once there's something worth
                    looking at.
                </p>
            </div>

            {featuredGame && <GameCard {...featuredGame} />}

        </div>
    </section>


    <!-- =====================================================
         DEV LOG
         ===================================================== -->

    <section class="devlog section">
        <div class="container">

            <div class="split-head">
                <div>
                    <p class="eyebrow">Dev log</p>
                    <h2 data-reveal>What we built, what broke, what we learned.</h2>
                </div>

                <div class="split-copy" data-reveal style="--reveal-index: 1">
                    <p>
                        Notes from making the game, including the parts that
                        didn't work and the occasional 2 a.m. disaster.
                    </p>

                    <a href="/devlog/" class="text-link">Read the dev log →</a>
                </div>
            </div>

            {
                latestPosts.length > 0 ? (
                    <div class="devlog-list" data-reveal>
                        {latestPosts.map((post) => (
                            <DevlogCard
                                id={post.id}
                                title={post.data.title}
                                description={post.data.description}
                                pubDate={post.data.pubDate}
                                tags={post.data.tags}
                            />
                        ))}
                    </div>
                ) : (
                    <p class="empty-log mono">
                        Nothing posted yet.
                    </p>
                )
            }

        </div>
    </section>

</BaseLayout>

<style>

    /* =====================================================
       HERO
       ===================================================== */

    .hero {
        position: relative;
        overflow: hidden;

        min-height: calc(100svh - var(--header-height));
        margin-top: calc(var(--header-height) * -1);
        padding-top: var(--header-height);

        display: flex;
        align-items: center;

        background:
            radial-gradient(
                ellipse 55% 60% at 75% 40%,
                rgb(121 83 245 / 14%),
                transparent 70%
            ),
            var(--ink-0);
    }

    .hero-shade {
        position: absolute;
        inset: 0;

        background: linear-gradient(
            90deg,
            rgb(13 15 19 / 92%) 0%,
            rgb(13 15 19 / 70%) 38%,
            transparent 72%
        );

        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;

        padding-block: clamp(4rem, 10vh, 8rem) clamp(8rem, 16vh, 10rem);

        pointer-events: none;
    }

    .hero-inner a {
        pointer-events: auto;
    }

    .hero-kicker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;

        margin-bottom: 2rem;

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .hero h1 {
        max-width: 11ch;
        margin-bottom: 2rem;

        font-size: clamp(2.6rem, 9.5vw, 9rem);
    }

    .hero .lede {
        max-width: 30rem;
        margin-bottom: 2.75rem;

        color: var(--color-gray);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .scroll-cue {
        position: absolute;
        z-index: 2;
        bottom: clamp(1.25rem, 3vw, 2rem);
        left: max(var(--page-padding), calc((100% - var(--content-width)) / 2));

        display: flex;
        align-items: center;
        gap: 0.85rem;

        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;

        transition: color var(--transition-fast);
    }

    .scroll-cue:hover,
    .scroll-cue:focus-visible {
        color: var(--color-white);
    }

    .scroll-line {
        position: relative;
        overflow: hidden;

        width: 1px;
        height: 2.75rem;

        background: var(--line-strong);
    }

    .scroll-line::after {
        position: absolute;
        top: 0;
        left: 0;

        width: 1px;
        height: 40%;

        background: var(--color-purple-bright);

        content: "";
        animation: scroll-drip 2.2s var(--ease-out) infinite;
    }

    @keyframes scroll-drip {
        from {
            transform: translateY(-100%);
        }

        to {
            transform: translateY(260%);
        }
    }


    /* =====================================================
       BELIEF
       ===================================================== */

    .belief {
        position: relative;
        overflow: hidden;

        padding-block: clamp(5rem, 12vw, 10rem);

        background: var(--color-purple);
        color: var(--color-white);
    }

    .belief::before {
        position: absolute;
        top: 50%;
        right: -4vw;

        color: rgb(13 15 19 / 12%);

        font-family: var(--font-brand);
        font-size: clamp(14rem, 34vw, 32rem);
        line-height: 1;

        content: "0x80";
        pointer-events: none;
        transform: translateY(-50%);
    }

    .belief .container {
        position: relative;
    }

    .belief-eyebrow {
        color: rgb(247 247 248 / 75%);
    }

    .belief-quote {
        max-width: 60rem;
        margin: 0;
    }

    .belief-setup {
        margin-bottom: 1.5rem;

        color: rgb(247 247 248 / 72%);

        font-size: clamp(1.3rem, 2.4vw, 2rem);
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.25;
    }

    .belief-punch {
        margin-bottom: 0;

        font-family: var(--font-display);
        font-size: clamp(2.4rem, 6vw, 5.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 0.95;
        text-wrap: balance;
    }

    .belief-punch em {
        color: var(--ink-0);
        font-style: italic;
    }


    /* =====================================================
       SHARED SECTION HEAD
       ===================================================== */

    .split-head {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: end;
        gap: clamp(2rem, 6vw, 6rem);

        margin-bottom: clamp(3rem, 7vw, 5.5rem);
    }

    .split-head h2 {
        margin-bottom: 0;
    }

    .split-copy {
        max-width: 32rem;
        margin-bottom: 0;

        color: var(--color-muted);

        font-size: 1.15rem;
    }

    .split-copy p:last-child {
        margin-bottom: 0;
    }

    .split-copy .text-link {
        display: inline-block;
        margin-top: 0.5rem;
    }


    /* =====================================================
       ARC
       ===================================================== */

    .arc-aside {
        font-size: 0.9rem;
    }

    .arc-steps {
        position: relative;

        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1.25rem;

        margin: 0;
        padding: 0;

        list-style: none;
    }

    /* The track behind the nodes, drawn in as the list reveals. */
    .arc-steps::before {
        position: absolute;
        top: 6px;
        left: 0;

        width: 100%;
        height: 1px;

        background: linear-gradient(
            90deg,
            var(--line-strong),
            var(--color-purple-bright)
        );

        content: "";
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1600ms var(--ease-out) 200ms;
    }

    :global(html:not(.js)) .arc-steps::before,
    .arc-steps:global(.is-visible)::before {
        transform: scaleX(1);
    }

    .arc-step {
        position: relative;
    }

    .step-node {
        display: block;

        width: 13px;
        height: 13px;

        margin-bottom: 1.75rem;

        border: 1px solid var(--line-strong);
        background: var(--ink-0);

        transition:
            background 400ms ease,
            border-color 400ms ease,
            box-shadow 400ms ease;
        transition-delay: calc(var(--step) * 180ms + 300ms);
    }

    .arc-steps:global(.is-visible) .step-node,
    :global(html:not(.js)) .step-node {
        border-color: var(--color-purple-bright);
        background: color-mix(
            in srgb,
            var(--color-purple-bright) calc(var(--step) * 16.6%),
            var(--ink-0)
        );
    }

    .arc-steps:global(.is-visible) .arc-step:last-child .step-node {
        box-shadow: 0 0 24px rgb(164 141 255 / 70%);
    }

    .step-number {
        display: block;

        margin-bottom: 0.5rem;

        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
    }

    .arc-step h3 {
        margin-bottom: 0.6rem;

        font-size: clamp(1.1rem, 1.6vw, 1.4rem);
        word-break: break-word;
        hyphens: auto;
    }

    .arc-step p {
        margin-bottom: 0;

        color: var(--color-muted);

        font-size: 0.95rem;
        line-height: 1.45;
    }

    .arc-step:last-child h3 {
        color: var(--color-purple-bright);
    }


    /* =====================================================
       PRINCIPLES
       ===================================================== */

    .principle-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        border-top: 1px solid var(--line-strong);
        border-left: 1px solid var(--line-strong);
    }

    .principle {
        position: relative;

        display: flex;
        flex-direction: column;

        min-height: 320px;
        padding: clamp(1.75rem, 3vw, 2.5rem);

        border-right: 1px solid var(--line-strong);
        border-bottom: 1px solid var(--line-strong);

        transition: background var(--transition-normal);
    }

    .principle::before {
        position: absolute;
        top: -1px;
        left: -1px;

        width: calc(100% + 2px);
        height: 2px;

        background: var(--color-purple-bright);

        content: "";
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 500ms var(--ease-out);
    }

    .principle:hover {
        background: var(--ink-1);
    }

    .principle:hover::before {
        transform: scaleX(1);
    }

    .principle:hover .principle-label {
        color: var(--color-white);
    }

    .principle-label {
        margin-bottom: auto;
        padding-bottom: 3rem;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;

        transition: color var(--transition-fast);
    }

    .principle h3 {
        margin-bottom: 1rem;
    }

    .principle p {
        margin-bottom: 0;

        color: var(--color-muted);
    }

    .principle-filter {
        grid-column: 1 / -1;

        flex-direction: row;
        align-items: end;
        gap: clamp(2rem, 8vw, 8rem);

        min-height: 0;

        background:
            linear-gradient(
                120deg,
                rgb(121 83 245 / 22%),
                transparent 65%
            );
    }

    .principle-filter .principle-label {
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .principle-filter h3 {
        max-width: 22ch;

        font-size: clamp(1.9rem, 3.5vw, 3rem);
        font-weight: 800;
    }

    .principle-filter p {
        max-width: 40rem;
    }


    /* =====================================================
       PROJECT / DEVLOG
       ===================================================== */

    .project {
        background:
            radial-gradient(
                ellipse 50% 60% at 10% 100%,
                rgb(121 83 245 / 10%),
                transparent 70%
            );
    }

    .empty-log {
        color: var(--color-purple-bright);
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 1000px) {
        .arc-steps {
            grid-template-columns: 1fr;
            gap: 0;
            padding-left: 2.5rem;
        }

        .arc-steps::before {
            top: 0;
            left: 6px;

            width: 1px;
            height: 100%;

            background: linear-gradient(
                180deg,
                var(--line-strong),
                var(--color-purple-bright)
            );
            transform: scaleY(0);
            transform-origin: top;
        }

        :global(html:not(.js)) .arc-steps::before,
        .arc-steps:global(.is-visible)::before {
            transform: scaleY(1);
        }

        .arc-step {
            padding-bottom: 2rem;
        }

        .step-node {
            position: absolute;
            top: 0.2rem;
            left: -2.5rem;

            margin: 0;
        }

        .principle-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 760px) {
        .scroll-cue {
            display: none;
        }

        .hero-shade {
            background: linear-gradient(
                180deg,
                rgb(13 15 19 / 55%) 0%,
                rgb(13 15 19 / 85%) 45%,
                rgb(13 15 19 / 55%) 100%
            );
        }

        .split-head {
            grid-template-columns: 1fr;
        }

        .principle-grid {
            grid-template-columns: 1fr;
        }

        .principle {
            min-height: 0;
        }

        .principle-filter {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
    }
</style>
