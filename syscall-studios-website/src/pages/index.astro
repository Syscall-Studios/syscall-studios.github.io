---
import BaseLayout from "../layouts/BaseLayout.astro";
import DevlogCard from "../components/DevlogCard.astro";
import games from "../data/games.json";
import site from "../data/site.json";
import { getPublishedPosts } from "../lib/devlog";

const featuredGame =
	games.find((game) => game.featured) ?? games[0];

const latestPosts = (await getPublishedPosts()).slice(0, 2);
---

<BaseLayout>
    <section class="hero">
        <div class="container hero-inner">

            <div class="hero-status">
                <span class="status-dot"></span>
                SYS::ONLINE
            </div>

            <h1 class="hero-title">
                <span class="visually-hidden">Syscall Studios</span>
                <img
                    class="hero-logo"
                    src="/brand/logo-full-box-light.svg"
                    alt=""
                />
            </h1>

            <p class="hero-tagline">
                {site.tagline}
            </p>

            <a
                href="/games"
                class="button"
            >
                View Our Work
            </a>

        </div>
    </section>


    <section class="studio-status section">
        <div class="container status-grid">

            <div>
                <p class="eyebrow">
                    STATUS | ACTIVE
                </p>

                <h2>
                    Something is compiling.
                </h2>
            </div>

            <div class="status-copy">
                <p>
                    We're an independent game studio currently
                    building our first title.
                </p>

                <p>
                    We're keeping the details quiet for now.
                    More soon.
                </p>
            </div>

        </div>
    </section>


	<section class="project section">
		<div class="container">

			<p class="eyebrow">
				SYS::GAMES
			</p>

			{
				featuredGame && (
					<a
						href="/games"
						class="project-card"
					>
						<div>

							<span class="project-number">
								{featuredGame.id.toUpperCase()}
							</span>

							<h2>
								{featuredGame.title}
							</h2>

							<p>
								{featuredGame.description}
							</p>

						</div>

						<div class="project-side">

							<span class="project-status">
								{featuredGame.status}
							</span>

							{
								!featuredGame.announced && (
									<span class="classified">
										[ CLASSIFIED ]
									</span>
								)
							}

						</div>
					</a>
				)
			}

		</div>
	</section>



    <section class="devlog section">
        <div class="container">

            <p class="eyebrow">
                SYS::DEVLOG
            </p>

            <div class="section-heading">
                <h2>From the Workbench</h2>

                <a href="/devlog">
                    View All →
                </a>
            </div>

            {
                latestPosts.length > 0 ? (
                    <div class="devlog-list">
                        {latestPosts.map((post) => (
                            <DevlogCard
                                id={post.id}
                                title={post.data.title}
                                description={post.data.description}
                                pubDate={post.data.pubDate}
                                tags={post.data.tags}
                            />
                        ))}
                    </div>
                ) : (
                    <div class="empty-log">
                        <span>DEVLOG | 000</span>
                        <p>Development transmissions will appear here.</p>
                    </div>
                )
            }

        </div>
    </section>
</BaseLayout>

<style>

    /* HERO */

    .hero {
        position: relative;
        overflow: hidden;

        min-height: calc(100vh - 89px);

        display: flex;
        align-items: center;

        text-align: center;
    }

    .hero::before {
        position: absolute;
        inset: 0;

        background:
            radial-gradient(
                circle at 50% 45%,
                rgb(121 83 245 / 14%),
                transparent 36%
            ),
            linear-gradient(
                rgb(216 216 216 / 3%) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgb(216 216 216 / 3%) 1px,
                transparent 1px
            );
        background-size: auto, 64px 64px, 64px 64px;

        content: "";
        mask-image: linear-gradient(to bottom, black, transparent 90%);
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;

        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-status {
        display: flex;
        align-items: center;
        gap: 0.6rem;

        margin-bottom: 2rem;

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        background: var(--color-accent);
        border-radius: 50%;

        box-shadow: 0 0 14px
            rgb(121 83 245 / 80%);

        animation: status-pulse 2.8s ease-in-out infinite;
    }

    .hero-title {
        margin: 0;
    }

    .hero-logo {
        width: min(360px, 68vw);
    }

    .hero-tagline {
        margin-top: 2.25rem;
        margin-bottom: 2rem;

        color: var(--color-muted);

        font-size: clamp(1.1rem, 2vw, 1.4rem);
    }


    /* STATUS */

    .studio-status {
        background: var(--color-white);
        color: var(--color-slate);
    }

    .status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(3rem, 8vw, 8rem);
    }

    .status-grid h2 {
        max-width: 600px;

        margin-bottom: 0;

        font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    }

    .status-copy {
        align-self: end;

        max-width: 500px;

        font-size: 1.15rem;
    }


    /* PROJECT */

	.project-card {
        position: relative;
        overflow: hidden;

		min-height: 340px;

		display: flex;
		justify-content: space-between;
		align-items: end;

		gap: 3rem;

		margin-top: 2rem;
		padding: clamp(2rem, 5vw, 4rem);

		border: 1px solid
			rgb(216 216 216 / 18%);

		background:
			linear-gradient(
				135deg,
				rgb(121 83 245 / 10%),
				transparent 55%
			);

		transition:
			border-color var(--transition-normal),
			transform var(--transition-normal),
			background var(--transition-normal);
	}

    .project-card::after {
        position: absolute;
        right: -5rem;
        bottom: -7rem;

        width: 22rem;
        height: 22rem;

        border: 1px solid rgb(121 83 245 / 18%);
        border-radius: 50%;
        box-shadow:
            0 0 0 3rem rgb(121 83 245 / 5%),
            0 0 0 6rem rgb(121 83 245 / 3%);

        content: "";
        pointer-events: none;
    }

	.project-card:hover,
    .project-card:focus-visible {
		border-color: rgb(121 83 245 / 60%);

		transform: translateY(-4px);

		background:
			linear-gradient(
				135deg,
				rgb(121 83 245 / 18%),
				transparent 60%
			);
	}

	.project-number,
	.project-status,
	.classified {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.project-number {
		color: var(--color-accent);
	}

	.project-card h2 {
		margin-top: 1rem;
		margin-bottom: 1rem;

		font-size: clamp(2.25rem, 4.5vw, 3.75rem);
	}

	.project-card p {
		max-width: 580px;

		margin-bottom: 0;

		color: var(--color-muted);
	}

	.project-side {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.75rem;

		flex-shrink: 0;
	}

	.project-status {
		color: var(--color-muted);
	}

	.classified {
		color: var(--color-accent);
	}


    /* DEVLOG */

    .devlog {
        background: var(--color-white);
        color: var(--color-slate);
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;

        gap: 2rem;

        margin-bottom: 3rem;
    }

    .section-heading h2 {
        margin-bottom: 0;

        font-size: clamp(2rem, 4vw, 3.25rem);
    }

    .section-heading a {
        color: var(--color-purple);

        font-family: var(--font-mono);
    }

    .empty-log {
        padding-block: 2rem;

        border-top: 1px solid var(--color-gray);
        border-bottom: 1px solid var(--color-gray);
    }

    .empty-log span {
        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.8rem;
    }

    .empty-log p {
        margin-top: 0.75rem;
        margin-bottom: 0;

        font-size: 1.15rem;
    }

    @keyframes status-pulse {
        50% {
            opacity: 0.55;
            transform: scale(0.82);
        }
    }


    /* RESPONSIVE */

    @media (max-width: 750px) {
        .hero {
            min-height: calc(100svh - 73px);
        }

        .status-grid {
            grid-template-columns: 1fr;
        }

        .project-card {
            min-height: 0;

            flex-direction: column;
            align-items: flex-start;
            gap: 2.5rem;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

		.project-side {
			align-items: flex-start;
		}
    }

</style>