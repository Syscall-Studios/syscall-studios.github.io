---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { socialLinks } from "../lib/socials";

const handles: Record<string, string> = {
    twitter: "@SyscallStudios",
    youtube: "@SyscallStudios",
    instagram: "@syscallstudios",
    tiktok: "@syscallstudios",
    reddit: "r/SyscallStudios",
    github: "Syscall-Studios",
    bluesky: "syscallstudios.bsky.social"
};

const otherEmails = [
    {
        label: "Press",
        address: site.emails.press,
        note: "Interviews, coverage, and anything else for a story."
    },
    {
        label: "Support",
        address: site.emails.support,
        note: "Found a bug, or need help with something? Start here."
    }
];
---

<BaseLayout
    title="Contact"
    description="Get in touch with Syscall Studios: business, press, partnerships, or just talking games."
    pageType="ContactPage"
>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Contact</p>

            <h1>Get in touch.</h1>

            <p class="lede">
                Business, press, partnerships, or you just want to talk
                about games. Pick whichever address fits best. We're a
                small studio, so it might take us a few days to reply, but
                we read everything.
            </p>
        </div>
    </section>


    <section class="email section">
        <div class="container">

            <a class="email-block" href={`mailto:${site.emails.hello}`} data-reveal>
                <span class="email-label">
                    <span class="status-dot"></span>
                    General & business
                </span>

                <span class="email-address">{site.emails.hello}</span>

                <span class="email-cta">
                    Send us an email <span aria-hidden="true">→</span>
                </span>
            </a>

            <div class="email-more">
                {
                    otherEmails.map((email, index) => (
                        <a class="email-card" href={`mailto:${email.address}`} data-reveal style={`--reveal-index: ${index + 1}`}>
                            <span class="email-label">{email.label}</span>
                            <span class="email-card-address">{email.address}</span>
                            <span class="email-card-note">{email.note}</span>
                        </a>
                    ))
                }
            </div>

        </div>
    </section>


    {
        socialLinks.length > 0 && (
            <section class="social section">
                <div class="container social-grid">

                    <div>
                        <p class="eyebrow">Elsewhere</p>
                        <h2 data-reveal>Find us elsewhere.</h2>
                        <p class="muted social-copy" data-reveal style="--reveal-index: 1">
                            We post new dev log entries there, along with the
                            odd work-in-progress screenshot.
                        </p>
                    </div>

                    <ul class="social-list">
                        {socialLinks.map((social, index) => (
                            <li data-reveal style={`--reveal-index: ${index % 3}`}>
                                <a
                                    href={social.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${social.label} (opens in a new tab)`}
                                >
                                    <span class="social-name">{social.label}</span>
                                    <span class="social-handle">{handles[social.id] ?? ""}</span>
                                    <span class="social-arrow" aria-hidden="true">↗</span>
                                </a>
                            </li>
                        ))}
                    </ul>

                </div>
            </section>
        )
    }

</BaseLayout>

<style>
    .email {
        padding-top: 0;
        border-top: 0;
    }

    .email-block {
        position: relative;
        overflow: hidden;

        display: grid;
        gap: 1.5rem;

        padding: clamp(1.5rem, 6vw, 4.5rem);

        border: 1px solid var(--line-strong);
        background:
            radial-gradient(
                ellipse 70% 120% at 100% 0%,
                rgb(121 83 245 / 25%),
                transparent 70%
            ),
            var(--ink-1);

        transition:
            border-color var(--transition-normal),
            transform var(--transition-normal);
    }

    .email-block:hover,
    .email-block:focus-visible {
        border-color: var(--color-purple-bright);
        transform: translateY(-3px);
    }

    .email-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        color: var(--color-purple-bright);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .email-address {
        font-family: var(--font-display);
        font-size: clamp(1.25rem, 5.6vw, 5.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1;

        word-break: break-word;
    }

    .email-cta {
        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .email-cta span {
        display: inline-block;
        transition: transform var(--transition-fast);
    }

    .email-block:hover .email-cta span {
        transform: translateX(5px);
    }

    .email-more {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;

        margin-top: 1.25rem;
    }

    .email-card {
        display: grid;
        align-content: start;
        gap: 0.75rem;

        padding: clamp(1.5rem, 3vw, 2.25rem);

        border: 1px solid var(--line-strong);
        background: var(--ink-1);

        transition:
            border-color var(--transition-normal),
            transform var(--transition-normal);
    }

    .email-card:hover,
    .email-card:focus-visible {
        border-color: var(--color-purple-bright);
        transform: translateY(-3px);
    }

    .email-card-address {
        font-size: clamp(1.2rem, 2.4vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -0.02em;

        word-break: break-word;
    }

    .email-card-note {
        color: var(--color-muted);
    }

    @media (max-width: 720px) {
        .email-more {
            grid-template-columns: 1fr;
        }
    }

    .social-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
    }

    .social-copy {
        max-width: 26rem;
        margin-top: 2rem;

        font-size: 1.15rem;
    }

    .social-list {
        margin: 0;
        padding: 0;

        border-top: 1px solid var(--line-strong);

        list-style: none;
    }

    .social-list a {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1.5rem;

        padding: 1.4rem 0;

        border-bottom: 1px solid var(--line-strong);

        transition:
            padding var(--transition-fast),
            background var(--transition-fast);
    }

    .social-list a:hover,
    .social-list a:focus-visible {
        padding-inline: 1rem;

        background: var(--ink-1);
    }

    .social-name {
        font-size: clamp(1.4rem, 2.5vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .social-handle {
        color: var(--color-dim);

        font-family: var(--font-mono);
        font-size: 0.85rem;
    }

    .social-arrow {
        color: var(--color-purple-bright);

        font-size: 1.25rem;
    }

    @media (max-width: 820px) {
        .social-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 520px) {
        .social-handle {
            display: none;
        }

        .social-list a {
            grid-template-columns: 1fr auto;
        }
    }
</style>
