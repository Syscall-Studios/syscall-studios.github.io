---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { socialLinks } from "../lib/socials";

const contacts = [
    {
        label: "BUSINESS",
        description: "Business, partnerships, licensing, and professional inquiries.",
        email: site.emails.business
    }
];
---

<BaseLayout
    title="Contact"
    description="Get in touch with Syscall Studios."
>

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="contact-hero">
        <div class="container">

            <p class="eyebrow">
                SYS::CONTACT
            </p>

            <h1>
                Say<br />
                Hello.
            </h1>

            <p class="hero-copy">
                Questions, partnerships, or just want to talk games?
                We'd love to hear from you.
            </p>

        </div>
    </section>


    <!-- =====================================================
         CONTACT ROUTES
         ===================================================== -->

    <section class="contact-section section">
        <div class="container">

            <p class="eyebrow">
                ROUTE::MESSAGE
            </p>

            <div class="contact-list">

                {
                    contacts.map((contact, index) => (
                        <a
                            class="contact-row"
                            href={`mailto:${contact.email}`}
                        >
                            <div class="contact-number">
                                0{index + 1}
                            </div>

                            <div class="contact-info">
                                <span class="contact-label">
                                    {contact.label}
                                </span>

                                <h2>
                                    {contact.email}
                                </h2>

                                <p>
                                    {contact.description}
                                </p>
                            </div>

                            <span
                                class="contact-arrow"
                                aria-hidden="true"
                            >
                                →
                            </span>
                        </a>
                    ))
                }

            </div>

        </div>
    </section>


    <!-- =====================================================
         SOCIAL
         ===================================================== -->

    {
        socialLinks.length > 0 && (
            <section class="social-section section">
                <div class="container social-grid">

                    <div>
                        <p class="eyebrow">
                            SYS::SOCIAL
                        </p>

                        <h2>
                            Elsewhere<br />
                            on the wire.
                        </h2>
                    </div>

                    <div class="social-links">

                        {
                            socialLinks.map((social) => (
                                <a
                                    href={social.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${social.label} (opens in a new tab)`}
                                >
                                    <span>
                                        {social.label.toUpperCase()}
                                    </span>

                                    <span aria-hidden="true">
                                        ↗
                                    </span>
                                </a>
                            ))
                        }

                    </div>

                </div>
            </section>
        )
    }


    <!-- =====================================================
         FOOTNOTE
         ===================================================== -->

    <section class="signal section">
        <div class="container signal-inner">

            <img
                src="/brand/logo-mark-light.svg"
                alt=""
                class="signal-logo"
            />

            <div>
                <p class="eyebrow">
                    SIGNAL::OPEN
                </p>

                <h2>
                    We're listening.
                </h2>

                <p>
                    We're a small studio, so replies may take a little time,
                    but messages are read by actual humans.
                </p>
            </div>

        </div>
    </section>

</BaseLayout>


<style>

    /* =====================================================
       HERO
       ===================================================== */

    .contact-hero {
        padding-top: clamp(7rem, 13vw, 12rem);
        padding-bottom: clamp(5rem, 10vw, 9rem);
    }

    .contact-hero h1 {
        margin-bottom: 2.5rem;

        font-size: clamp(3.5rem, 10vw, 8rem);
    }

    .hero-copy {
        max-width: 650px;

        margin-bottom: 0;

        color: var(--color-muted);

        font-size: clamp(1.15rem, 2vw, 1.4rem);
    }


    /* =====================================================
       CONTACT
       ===================================================== */

    .contact-section {
        background: var(--color-white);
        color: var(--color-slate);
    }

    .contact-list {
        margin-top: 3rem;

        border-top: 1px solid var(--color-gray);
    }

    .contact-row {
        display: grid;
        grid-template-columns:
            minmax(50px, 80px)
            1fr
            auto;

        align-items: center;

        gap: 2rem;

        padding-block: clamp(2rem, 5vw, 3.5rem);

        border-bottom: 1px solid var(--color-gray);

        transition:
            padding-left var(--transition-normal),
            background var(--transition-normal);
    }

    .contact-row:hover,
    .contact-row:focus-visible {
        padding-left: 1rem;

        background:
            linear-gradient(
                90deg,
                rgb(121 83 245 / 6%),
                transparent 60%
            );
    }

    .contact-number {
        align-self: start;

        padding-top: 0.55rem;

        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
    }

    .contact-label {
        display: block;

        margin-bottom: 0.65rem;

        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
    }

    .contact-info h2 {
        margin-bottom: 0.75rem;

        font-family: var(--font-body);
        font-size: clamp(1.6rem, 4vw, 3.25rem);
        font-weight: 600;
        letter-spacing: normal;

        word-break: break-word;
    }

    .contact-info p {
        margin-bottom: 0;

        color: rgb(67 75 87 / 72%);
    }

    .contact-arrow {
        color: var(--color-purple);

        font-family: var(--font-mono);
        font-size: 2rem;

        transition: transform var(--transition-fast);
    }

    .contact-row:hover .contact-arrow,
    .contact-row:focus-visible .contact-arrow {
        transform: translateX(7px);
    }


    /* =====================================================
       SOCIAL
       ===================================================== */

    .social-section {
        background:
            linear-gradient(
                135deg,
                rgb(121 83 245 / 8%),
                transparent 45%
            );
    }

    .social-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;

        gap: clamp(4rem, 10vw, 9rem);
    }

    .social-grid h2 {
        margin-bottom: 0;
    }

    .social-links {
        align-self: end;

        border-top: 1px solid
            rgb(216 216 216 / 18%);
    }

    .social-links a {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding-block: 1.25rem;

        border-bottom: 1px solid
            rgb(216 216 216 / 18%);

        color: var(--color-muted);

        font-family: var(--font-mono);
        font-size: 0.9rem;
        letter-spacing: 0.08em;

        transition:
            color var(--transition-fast),
            padding-left var(--transition-fast);
    }

    .social-links a:hover,
    .social-links a:focus-visible {
        padding-left: 0.75rem;

        color: var(--color-white);
    }

    .social-links a span:last-child {
        color: var(--color-purple);
    }


    /* =====================================================
       SIGNAL
       ===================================================== */

    .signal {
        padding-block: clamp(5rem, 9vw, 8rem);

        border-top: 1px solid
            rgb(216 216 216 / 12%);
    }

    .signal-inner {
        display: grid;
        grid-template-columns:
            minmax(150px, 280px)
            1fr;

        align-items: center;

        gap: clamp(3rem, 8vw, 8rem);
    }

    .signal-logo {
        width: min(220px, 100%);
    }

    .signal h2 {
        margin-bottom: 1.25rem;
    }

    .signal p:last-child {
        max-width: 560px;

        margin-bottom: 0;

        color: var(--color-muted);
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 750px) {

        .contact-row {
            grid-template-columns: 45px 1fr;
        }

        .contact-arrow {
            display: none;
        }

        .social-grid,
        .signal-inner {
            grid-template-columns: 1fr;
        }

        .signal-logo {
            width: 140px;
        }
    }

</style>